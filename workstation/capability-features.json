      "runtime": "local_ai",
      "requirements": [{ "id": "offer-details", "label": "Confirmed offer, company, manager, pay, start-date, and signing details", "kind": "user_input", "required": true }],
      "outside_world": true,
      "outside_world_note": "This creates an editable draft only. It does not issue or send an offer."
    },
    {
      "id": "cover-letter",
