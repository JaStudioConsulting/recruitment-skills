      "runtime": "local_ai",
      "requirements": [
        { "id": "resume", "label": "Reviewed resume", "kind": "source", "source_kinds": ["resume"], "required": true },
        { "id": "job-description", "label": "Reviewed job description", "kind": "source", "source_kinds": ["job_description"], "required": true }
      ],
      "outside_world": false
