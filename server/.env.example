# TTTG Recruiting MCP server - environment template.
# Copy to server/.env and fill with your real values at deploy time.
# NEVER commit the real .env (it is gitignored). No secrets belong in the repo.

# --- Server ---
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# --- OAuth for the MCP connector (how ChatGPT/host authenticates users) ---
# Create the OAuth app with your identity provider, then paste the values here.
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_AUTHORIZATION_URL=https://your-idp.example.com/authorize
OAUTH_TOKEN_URL=https://your-idp.example.com/token
OAUTH_REDIRECT_URI=https://your-deployed-host.example.com/oauth/callback
OAUTH_SCOPES=openid email profile

# --- Downstream connectors (only if you wire the stub tools) ---
# Gmail (find_email / send_email)
GMAIL_OAUTH_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=your-gmail-oauth-client-secret
# Google Calendar (create_calendar_event) - often the same Google OAuth app as Gmail
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
# Loxo (update_loxo_record) - Loxo API credentials
LOXO_API_KEY=your-loxo-api-key
LOXO_AGENCY_SLUG=your-loxo-agency-slug
