{
  "name": "@jastudioconsulting/recruitment-skills",
  "version": "0.1.0",
  "type": "module",
  "description": "Private, router-first recruiting skills authority for Ja Studio Consulting.",
  "exports": {
    ".": "./lib/index.js",
    "./skills/*": "./skills/*",
    "./manifests/*": "./skills/manifests/*",
    "./package.json": "./package.json"
  },
  "files": ["lib", "skills", "docs", "tests/fixtures", "README.md", "SECURITY.md", "NOTICE.md"],
  "scripts": {
    "validate": "node scripts/validate-package.mjs",
    "test": "node --test test/*.test.mjs",
    "check:python": "node scripts/check-python-syntax.mjs",
    "pack:check": "node scripts/check-packed-artifact.mjs"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
